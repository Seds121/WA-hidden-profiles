# Optional: customize port (Next.js also reads this)
PORT=3000

# Session folder for whatsapp-web.js LocalAuth (default is .wwebjs_auth)
WWJS_SESSION_DIR=.wwebjs_auth

# Fallback country code for ambiguous 10-digit numbers (Pakistan = 92)
WWJS_DEFAULT_COUNTRY_CODE=92

# Optional: path to Chrome/Edge if Puppeteer's bundled browser is missing
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
