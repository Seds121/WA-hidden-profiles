# Optional: customize port (Next.js also reads this)
PORT=3000

# Session folder for whatsapp-web.js LocalAuth (default is .wwebjs_auth)
WWJS_SESSION_DIR=.wwebjs_auth

# Fallback country code for ambiguous 10-digit numbers (Pakistan = 92)
WWJS_DEFAULT_COUNTRY_CODE=92

# Optional: path to Chrome/Edge if Puppeteer's bundled browser is missing
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Public URL used in API responses (profile photo links for Ocean)
# PUBLIC_BASE_URL=http://YOUR_VPS_IP:3002

# CORS for Ocean (comma-separated origins). Use * to allow all (default).
# OCEAN_CORS_ORIGINS=https://your-ocean-app.com

# Queue worker: 50 live fetches per linked WhatsApp, then 20 minute rest
# WA_FETCH_BATCH_SIZE=50
# WA_FETCH_REST_MS=1200000
